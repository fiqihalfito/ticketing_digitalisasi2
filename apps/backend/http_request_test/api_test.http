
@baseurl = http://localhost:3000

### Mengambil data user dari GitHub
GET {{baseurl}}/subbidang

### redirect to elysia
GET {{baseurl}}/toElysia

### tes post body
POST {{baseurl}}/user
Content-Type: application/json

{
    "name": "Fiqh",
    "age": 12
}

### profile cookie
GET {{baseurl}}/profile

### sign up new user or account
POST {{baseurl}}/api/auth/sign-up/email
Content-Type: application/json

{
    "name": "Admin Apotek",
    "email": "fiqihalfito.dev@gmail.com",
    "password": "123456"
}

### health check
GET {{baseurl}}/api/auth/ok

### login - sign in
POST {{baseurl}}/auth/api/sign-in/email HTTP/1.1
# Host: replace.me
Accept: application/json
Content-Type: application/json
# Authorization: Bearer YOUR_SECRET_TOKEN
Origin: {{baseurl}}

{
  "email": "testnewuser1@iconpln.co.id",
  "password": "12345678",
  "callbackURL": "",
  "rememberMe": true
}

### logout - sign out
POST {{baseurl}}/auth/api/sign-out HTTP/1.1
# Host: replace.me
Accept: application/json
Content-Type: application/json
# Authorization: Bearer YOUR_SECRET_TOKEN
Origin: {{baseurl}}

{}