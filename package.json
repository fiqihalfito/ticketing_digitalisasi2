{
  "name": "ticketing-digitalisasi2-monorepo",
  "private": true,
  "scripts": {
    "dev": "bun run infra:up && turbo dev",
    "infra:up": "podman compose up -d",
    "infra:down": "podman compose down",
    "build-backend": "podman run --replace --network ticketing_digitalisasi2_default --env-file apps/backend/.env.prod -p 3001:3001 --name elysia-mono-container elysia-mono"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "elysia": "1.4.30",
    "@types/bun": "^1.4.1"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  }
}